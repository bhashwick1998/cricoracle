# Point directly to your Cloudflare-proxied backend API custom domain
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# Your deployed frontend URL (used for SEO canonical links, OpenGraph, sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Keep false for public crowds so viewers use Cloudflare CDN (s-maxage=15) instead of Render WebSockets
NEXT_PUBLIC_ENABLE_WS=false
