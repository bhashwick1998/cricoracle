# ------------------------------------------------------------------
# Option 2 (Recommended if NO custom domain — Vercel Edge CDN Proxy)
# Leave NEXT_PUBLIC_API_URL unset so browser polls hit /api/* on Vercel Edge (s-maxage=15)
# ------------------------------------------------------------------
BACKEND_URL=https://cricoracle-backend-xzcw.onrender.com
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_ENABLE_WS=false

# ------------------------------------------------------------------
# Option 1 (Only if using your own Cloudflare custom API domain)
# Uncomment below to bypass Vercel /api/* proxy and hit Cloudflare directly:
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
# ------------------------------------------------------------------
